# Copy locally to .env.admin-acceptance.local (ignored by Git).
# A dedicated disposable Supabase project ONLY. Never use the production project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy keys are supported if the test project uses them.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Test project's database connection OR Management API token, for schema setup.
# Keep all values local. Never paste them into chat, logs, or command arguments.
HEBA_ACCEPTANCE_DATABASE_URL=
SUPABASE_ACCESS_TOKEN=
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3170
HEBA_DEPLOYMENT_ENV=staging
HEBA_COST_MODE=free
# Owner fixture credentials are generated in memory by acceptance setup.
# No production email, customer data, mail provider, or password belongs here.
