# Supabase (public — safe for browser). Use the hosting environment variables;
# this repository intentionally contains names only, never values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase (SERVER ONLY — never expose to the browser, never prefix with NEXT_PUBLIC_)
# Preferred: an independently revocable sb_secret key. The legacy service-role
# variable is transitional only and must be removed from deployed environments after cutover.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Owner entry identity (SERVER ONLY). Actual password stays in Supabase Auth.
OWNER_ADMIN_EMAIL=
# Staff retain individual accounts and MFA. Preview is never production access.
HEBA_PREVIEW_ADMIN_EMAIL=
HEBA_PREVIEW_ADMIN_PASSWORD=
HEBA_PREVIEW_ADMIN_SESSION_SECRET=

# Transactional email (SERVER ONLY). Both names are required before the
# outbox adapter can send; never use a personal mailbox password here.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Error monitoring. Runtime DSNs are configuration, while SENTRY_AUTH_TOKEN is
# build/CI-only for artifact upload and must never enter the browser bundle.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_RELEASE=
SENTRY_AUTH_TOKEN=

# Optional server-side malware scanning hook. When configured, upload publication
# fails closed unless the endpoint returns JSON: {"verdict":"clean"}.
PROTECTED_UPLOAD_SCAN_URL=
PROTECTED_UPLOAD_SCAN_TOKEN=

# Site
NEXT_PUBLIC_SITE_URL=https://hebaelsherif.com

# Hosting environment. Supported non-production values are `preview` for the
# explicit provider-free demonstration and `staging` for the isolated provider
# acceptance environment. Never set `preview` on Production. Both staging
# access variables are required on Staging and deliberately omitted from source.
HEBA_DEPLOYMENT_ENV=
# Default launch policy: paid video adapters disabled. Keep free for this release.
HEBA_COST_MODE=free
STAGING_ACCESS_USER=
STAGING_ACCESS_PASSWORD=

# Seeding (never true in production)
SEED_DEMO=false

# Historical paid adapter; keep these EMPTY for free launch.
CLOUDFLARE_STREAM_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_HOST=
