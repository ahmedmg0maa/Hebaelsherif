diff --git a/lib/heba-guards.js b/lib/heba-guards.js
new file mode 100644
index 0000000000000000000000000000000000000000..46bf464ef0df3797fdb0ba585f96640a16cbfbe1
--- /dev/null
+++ b/lib/heba-guards.js
@@ -0,0 +1,30 @@
+'use strict';
+// Local mitigation for GHSA-vfj7-8cjw-p6xm. Limits cannot be disabled by options.
+const MAX_DEPTH = 64;
+const MAX_NODES = 16384;
+const fail = () => { throw new RangeError('BRACES_COMPLEXITY_LIMIT'); };
+exports.assertPattern = input => {
+  if (typeof input !== 'string') return; // Preserve upstream type validation.
+  const stack = [];
+  for (let i = 0; i < input.length; i++) {
+    if (input[i] === '\\') { i++; continue; }
+    if (input[i] === '{' || input[i] === '(') {
+      stack.push(input[i]);
+      if (stack.length > MAX_DEPTH) fail();
+    } else if ((input[i] === '}' && stack[stack.length - 1] === '{') || (input[i] === ')' && stack[stack.length - 1] === '(')) stack.pop();
+  }
+};
+exports.assertAst = ast => {
+  const stack = [{ node: ast, depth: 0 }], seen = new Set();
+  let visited = 0;
+  while (stack.length) {
+    const { node, depth } = stack.pop();
+    if (!node || typeof node !== 'object' || seen.has(node) || depth > MAX_DEPTH || ++visited > MAX_NODES) fail();
+    seen.add(node);
+    if (node.nodes) {
+      if (!Array.isArray(node.nodes) || node.nodes.length + visited > MAX_NODES) fail();
+      for (const child of node.nodes) stack.push({ node: child, depth: depth + 1 });
+    }
+  }
+};
+
